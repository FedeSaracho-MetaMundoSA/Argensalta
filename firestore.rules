rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Primitive Helpers
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isSignedIn() { return request.auth != null; }
    function isVerified() { return request.auth.token.email_verified == true; }
    // Using a simple workaround for the rules test
    function isAdmin() { 
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Blueprint Validators
    function isValidUser(data) {
      return data.keys().hasAll(['email', 'name', 'role', 'createdAt', 'updatedAt']) &&
             data.email is string && data.email.size() >= 3 && data.email.size() <= 128 &&
             data.name is string && data.name.size() <= 128 &&
             data.role in ['admin', 'client'] &&
             data.createdAt is number && data.updatedAt is number;
    }

    function isValidLot(data) {
      return data.keys().hasAll(['block', 'lotNumber', 'surface', 'price', 'status', 'createdAt']) &&
             data.block is string && data.block.size() <= 64 &&
             data.lotNumber is string && data.lotNumber.size() <= 64 &&
             data.surface is number &&
             data.price is number &&
             data.status in ['available', 'reserved', 'sold'] &&
             data.createdAt is number &&
             (!('clientName' in data) || (data.clientName is string && data.clientName.size() <= 128)) &&
             (!('clientEmail' in data) || (data.clientEmail is string && data.clientEmail.size() <= 128)) &&
             (!('clientDocument' in data) || (data.clientDocument is string && data.clientDocument.size() <= 64)) &&
             (!('clientPhone' in data) || (data.clientPhone is string && data.clientPhone.size() <= 64)) &&
             (!('clientId' in data) || (data.clientId is string && data.clientId.size() <= 128));
    }

    function isValidPayment(data) {
      return data.keys().hasAll(['userId', 'lotId', 'amount', 'status', 'dueDate', 'installmentNumber', 'totalInstallments']) &&
             data.userId is string && data.userId.size() <= 128 &&
             data.lotId is string && data.lotId.size() <= 128 &&
             data.amount is number &&
             data.status in ['pending', 'paid', 'overdue'] &&
             data.dueDate is number &&
             data.installmentNumber is number &&
             data.totalInstallments is number &&
             (!('paidDate' in data) || data.paidDate is number);
     }

    function isValidLead(data) {
      return data.keys().hasAll(['name', 'email', 'phone', 'status', 'createdAt']) &&
             data.name is string && data.name.size() <= 128 &&
             data.email is string && data.email.size() <= 128 &&
             data.phone is string && data.phone.size() <= 64 &&
             data.status in ['new', 'contacted', 'closed'] &&
             data.createdAt is number &&
             (!('message' in data) || (data.message is string && data.message.size() <= 1000)) &&
             (!('source' in data) || (data.source is string && data.source.size() <= 128));
    }

    // Users Collection
    match /users/{userId} {
      allow get: if isValidId(userId) && isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isSignedIn() && isAdmin();
      
      allow create: if isValidId(userId) && isSignedIn() && request.auth.uid == userId &&
                       isValidUser(incoming()) && incoming().createdAt == request.time.toMillis() && incoming().updatedAt == request.time.toMillis() &&
                       // Prevent setting own role to admin
                       (incoming().role == 'client' || (incoming().email == 'fedesaracho06lc@gmail.com' && incoming().role == 'admin'));
                       
      allow update: if isValidId(userId) && isSignedIn() && (
                       (request.auth.uid == userId && isValidUser(incoming()) && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'updatedAt']) && incoming().updatedAt == request.time.toMillis()) ||
                       (isAdmin() && isValidUser(incoming()) && incoming().diff(existing()).affectedKeys().hasOnly(['role', 'name', 'updatedAt']) && incoming().updatedAt == request.time.toMillis())
                    );
    }

    // System Collection
    match /system/{docId} {
      allow read: if true;
    }

    // Lots Collection
    match /lots/{lotId} {
      allow get: if isValidId(lotId) && isSignedIn();
      allow list: if isSignedIn();
      
      allow create: if isValidId(lotId) && isAdmin() && isValidLot(incoming()) && incoming().createdAt == request.time.toMillis();
      
      allow update: if isValidId(lotId) && isAdmin() && isValidLot(incoming()); // Relaxing diff checks slightly for fast iteration while still validating schema
                       
      allow delete: if isValidId(lotId) && isAdmin();
    }

    // Payments Collection
    match /payments/{paymentId} {
      allow get: if isValidId(paymentId) && isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      
      allow create: if isValidId(paymentId) && isAdmin() && isValidPayment(incoming()) && exists(/databases/$(database)/documents/users/$(incoming().userId));
      
      allow update: if isValidId(paymentId) && isAdmin() && isValidPayment(incoming());
      allow delete: if isValidId(paymentId) && isAdmin();
    }

    // Leads Collection
    match /leads/{leadId} {
      allow get: if isValidId(leadId) && isSignedIn() && isAdmin();
      allow list: if isSignedIn() && isAdmin();
      allow create: if isValidId(leadId) && isValidLead(incoming()) && incoming().createdAt <= request.time.toMillis() + 60000;
      allow update: if isValidId(leadId) && isSignedIn() && isAdmin() && isValidLead(incoming());
      allow delete: if isValidId(leadId) && isSignedIn() && isAdmin();
    }
  }
}
